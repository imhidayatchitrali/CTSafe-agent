# CT Safe DVR Agent - example environment file.
# Copy to a local private env file and fill values there. Do not commit secrets.

DVR_APP_NAME="CT Safe DVR Agent"
DVR_ENV=local

# Backend/runtime storage
DVR_REPOSITORY_BACKEND=memory
DVR_AGNO_DB_URL=
DVR_AGNO_DB_SCHEMA=ai

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# RAG
DVR_RAG_BACKEND=supabase
DVR_RAG_VERSION=legacy
DVR_RAG_V2_LEGACY_FALLBACK=true
DVR_RAG_ALLOW_FALLBACK=true
DVR_RAG_POLICY_VERSION=rag_policy_v0_1
DVR_EMBEDDING_PROVIDER=openrouter
DVR_EMBEDDING_MODEL=openai/text-embedding-3-small

# LLM provider
DVR_DEFAULT_LLM_PROVIDER=openrouter
DVR_DEFAULT_MODEL=
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE="CT Safe DVR Agent"

# Optional OpenAI API fallback
OPENAI_API_KEY=

# Optional OpenAI subscription bridge - single tenant only
OPENAI_SUBSCRIPTION_BRIDGE_ENABLED=false
OPENAI_SUBSCRIPTION_BRIDGE_URL=
OPENAI_SUBSCRIPTION_BRIDGE_SESSION_REF=
OPENAI_SUBSCRIPTION_BRIDGE_HEALTHCHECK_REQUIRED=true

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Output/template
DVR_OUTPUT_DIR=generated_documents
DVR_TEMPLATE_PATH="esempi dvr per template/01_DVR-spheractsafe (1).docx"
DVR_ALLOWED_OPERATOR_IDS=local-client,local-reviewer,local-admin
DVR_PROMPT_VERSION=prompts_v0_1
DVR_ENABLE_AGENTOS=false
